generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model ProductCategory {
  id           Int                 @id @default(autoincrement())
  slug         String              @unique
  name         String
  description  String              @default("")
  sortOrder    Int                 @default(0)
  isPublished  Boolean             @default(true)
  subcategories ProductSubcategory[]
  products     Product[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProductSubcategory {
  id          Int                         @id @default(autoincrement())
  categoryId  Int
  category    ProductCategory             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String                      @default("")
  sortOrder   Int                         @default(0)
  isPublished Boolean                     @default(true)
  products    ProductSubcategoryAssignment[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model Product {
  id              Int                           @id @default(autoincrement())
  slug            String                        @unique
  name            String
  categoryId      Int
  category        ProductCategory               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price           String                        @default("")
  mainImageKey    String?
  mainImage       MediaAsset?                   @relation("ProductMainImage", fields: [mainImageKey], references: [key], onDelete: SetNull)
  productCode     String                        @default("")
  sortOrder       Int                           @default(0)
  isPublished     Boolean                       @default(true)
  isFeatured      Boolean                       @default(false)
  featuredSortOrder Int?
  isImportPending Boolean                       @default(false)
  specifications  ProductSpecification[]
  images          ProductImage[]
  subcategories   ProductSubcategoryAssignment[]
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([categoryId, sortOrder])
  @@index([isPublished, sortOrder])
}

model ProductSubcategoryAssignment {
  productId     Int
  subcategoryId Int
  sortOrder     Int                @default(0)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  subcategory   ProductSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([productId, subcategoryId])
  @@index([subcategoryId])
}

model ProductSpecification {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  sortOrder Int      @default(0)

  @@index([productId, sortOrder])
  @@unique([productId, sortOrder])
}

model ProductImage {
  productId Int
  assetKey  String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetKey], references: [key], onDelete: Cascade)
  sortOrder Int        @default(0)

  @@id([productId, assetKey])
  @@index([productId, sortOrder])
}

model MediaAsset {
  id             String        @id @default(cuid())
  key            String        @unique
  sourcePath     String?       @unique
  contentType    String
  byteSize       BigInt        @default(0)
  altText        String        @default("")
  uploadedAt     DateTime?
  mainForProducts Product[]    @relation("ProductMainImage")
  productImages  ProductImage[]
  awards         Award[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// Retained for compatibility with the earlier import; public redirects are configured in lib/config/site-routes.ts.
model LegacyRedirect {
  sourceSlug  String   @id
  destination String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyProfile {
  id                  String   @id @default("main")
  brand               String
  legalName           String
  sellerName          String
  founded             Int
  address             String
  phoneDisplay        String
  phoneLink           String
  gst                 String
  coordinates         String
  website             String
  videoId             String
  videoThumbnailKey   String
  storyImageKey       String
  logoKey             String
  ratingScore         String
  ratingCount         Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CompanyMilestone {
  id        Int      @id @default(autoincrement())
  year      String
  title     String
  detail    String
  sortOrder Int      @default(0)
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, title])
  @@index([isPublished, sortOrder])
}

model CompanyInsight {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  section   String
  title     String?
  body      String
  sortOrder Int      @default(0)
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, isPublished, sortOrder])
}

model Award {
  id        Int         @id @default(autoincrement())
  year      String
  title     String      @unique
  detail    String
  imageKey  String?
  image     MediaAsset? @relation(fields: [imageKey], references: [key], onDelete: SetNull)
  sortOrder Int         @default(0)
  isPublished Boolean   @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([isPublished, sortOrder])
}

model RatingBreakdown {
  stars     Int      @id
  percent   Int
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model SiteNotice {
  id           String   @id @default("main")
  title        String
  body         String
  accountName  String
  bank         String
  accountNumber String
  ifsc         String
  address      String
  contactName  String
  contactPhone String
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EditorialPage {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  eyebrow        String
  title           String
  intro           String
  metaDescription String
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
